$grp LL_MissionDescription : "{4A2582FF7C761EAE}Prefabs/Map/LL_MissionDescription.et" {
 MissionIntroduction {
  coords 4025.975 617.235 6749.153
  m_sTitle "Описание события"
  m_sTextData "18 июля 2021 года, Чернарусь."\
  ""\
  "Военный конфликт в стране переходит в стадию заморозки. Линия фронта между Чернарусскими силами обороны и ЧДКЗ замирает. Стороны договариваются о прекращении огня."\
  ""\
  "На фоне стабилизации фронта руководство Чернаруси принимает решение расформировать наименее лояльную часть вооружённых сил — добровольческие формирования."\
  ""\
  "28-й добровольческий батальон «Норманн» отказывается сложить оружие и отходит в горную местность Низлянской области, где присягает на верность запрещённой праворадикальной партии NAPA."\
  ""\
  "Чернарусские силы обороны входят в Низлянскую область с целью уничтожения вчерашних товарищей по оружию."
 }
 Conditions {
  coords 4025.46 618.45 6766.948
  m_sTitle "Общие условности"
  m_sTextData "Условности для всех:"\
  "— Запрещено снимать или переодевать форму. Смена головных уборов на союзные разрешена."\
  "— Запрещено использовать вражескую форму, бронежилеты, разгрузки, головные уборы. Рюкзаки использовать можно."\
  "— Не используйте игровой чат. О проблеме сообщите администратору другим способом."\
  "— Запрещено блокировать любые входы в здания внутри <link=Port>зеленого триггера</link>."\
  "— Запрещено заходить в воду, загонять технику в воду, высаживать десант на воду."\
  ""\
  "Время:"\
  "— Подготовка к эпизоду — 5 минут."\
  "— Активная фаза эпизода — 80 минут."
  m_iOrder 1
 }
 USConditions {
  coords 4005.176 620.02 6742.92
  m_sTitle "Условности атаки, США"
  m_sTextData "Условности США:"\
  "— Вертолетам запрещен взлет на фризтайме."\
  "— Высадка десанта разрешена только севернее  <link=RedLine>красного маркера</link>."\
  "— Если вертолет был сбит над водой и сумел совершить посадку, экипажу и десанту требуется кратчайшим путем вернуться на сушу."\
  ""\
  "Условия победы в эпизоде:"\
  "— На момент окончания эпизода захвачен <link=Port>порт</link> (красный триггер)."\
  "— В живых осталось пять или менее игроков СССР."\
  "— Создан четырехкратный перевес над СССР в численности."\
  ""\
  "Условие захвата:"\
  "— Чтобы захватить <link=Port>порт</link>, США необходимо поддерживать в триггере двукратный перевес в живой силе на протяжении двух минут."
  m_iOrder 2
 }
 USSRConditions {
  coords 4009.984 616.235 6744.253
  m_sTitle "Условности обороны, СССР"
  m_sTextData "Условности СССР:"\
  "— Запрещено пересекать <link=RedLine>красный маркер</link>."\
  ""\
  "Условия победы в эпизоде:"\
  "— На момент окончания эпизода удержан <link=Port>порт</link> (красный триггер)."\
  "— В живых осталось семь или менее игроков США."\
  "— Создан четырехкратный перевес над США в численности."\
  ""\
  "Условие захвата:"\
  "— Чтобы захватить <link=Port>порт</link>, США необходимо поддерживать в триггере двукратный перевес в живой силе на протяжении двух минут."
  m_iOrder 3
 }
 Help {
  coords 4032.833 611.487 6739.287
  m_sTitle "Помощь во время игры"
  m_sTextData "Если во время игры вам потребуется техническая помощь, зажмите кнопку Y — это уведомит администратора. Также можно обратиться к администратору в Discord или в личном чате Telegram. Администратор всегда на связи во время игры."
  m_iOrder 6
 }
 StaticHelp {
  coords 4049.712 619.113 6734.593
  m_sTitle "О стационарном вооружении"
  m_sTextData "Чтобы разобрать статическое вооружение (пулеметы, АГС и т.д.), возьмите в руки лопату и через Alt найдите действие разбора орудия."\
  ""\
  "Далее разобранные части орудия можно подобрать как рюкзак и переносить на себе или перевозить в транспорте."
  m_iOrder 5
 }
}